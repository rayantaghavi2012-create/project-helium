TELEGRAM_BOT_TOKEN=replace-with-your-bot-token-from-botfather
# Local dev: point at your own Postgres instance, e.g. a free Railway Postgres
# plugin (via `railway connect postgres` or its copied connection string) or
# any local/Docker Postgres. Railway production sets this automatically when
# you reference the Postgres plugin's DATABASE_URL in this service's variables.
DATABASE_URL="postgresql://user:password@localhost:5432/project_helium"
NODE_ENV=development
ADMIN_TELEGRAM_IDS=
